{
  "name": "capturepro",
  "productName": "CapturePro",
  "version": "0.1.0",
  "description": "High-performance screen, game, webcam and audio recorder",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "build:helper": "node scripts/build-helper.js",
    "start": "npm run build:helper && node scripts/start.js",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node test/e2e/drawing.js && node test/e2e/smoke.js && node test/e2e/overlays.js && node test/e2e/automation.js && node test/e2e/microphone.js && node test/e2e/stress.js",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.js",
    "dist": "npm run build:helper && npm run prepare:ffmpeg && electron-builder --win",
    "prepare:ffmpeg:mac": "node scripts/prepare-ffmpeg-mac.js",
    "dist:mac": "npm run build:helper && npm run prepare:ffmpeg:mac && electron-builder --mac --publish never && bash scripts/make-dmg.sh arm64 && bash scripts/make-dmg.sh x64"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.49.1"
  },
  "build": {
    "appId": "com.capturepro.app",
    "productName": "CapturePro",
    "copyright": "Copyright © 2026 CapturePro",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "package.json",
      "src/**/*",
      "assets/**/*",
      "!**/*.md"
    ],
    "asarUnpack": [
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "CapturePro",
      "extraResources": [
        {
          "from": "native/bin/CaptureProHelper.exe",
          "to": "native/CaptureProHelper.exe"
        },
        {
          "from": "vendor/ffmpeg",
          "to": "ffmpeg"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CapturePro",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "uninstallDisplayName": "CapturePro",
      "artifactName": "CapturePro-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "CapturePro-Portable-${version}.${ext}"
    },
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "category": "public.app-category.video",
      "icon": "assets/icon-mac.png",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "minimumSystemVersion": "11.0",
      "artifactName": "CapturePro-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "CapturePro uses the camera for the webcam overlay and device recording.",
        "NSMicrophoneUsageDescription": "CapturePro records your microphone together with the screen.",
        "NSAppleEventsUsageDescription": "CapturePro can shut down or sleep the Mac after a recording finishes, if you enable it."
      },
      "extraResources": [
        {
          "from": "native/bin/CaptureProHelper",
          "to": "native/CaptureProHelper"
        },
        {
          "from": "vendor/ffmpeg-mac-${arch}",
          "to": "ffmpeg"
        }
      ]
    }
  },
  "author": "CapturePro"
}
